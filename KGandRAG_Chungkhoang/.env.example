# Chạy offline: TF-IDF retrieval + Knowledge Graph; không cần key hoặc máy chủ DB.
LLM_PROVIDER=none
RETRIEVAL_ENCODER=tfidf

# Tùy chọn: bật sinh câu trả lời từ LLM tương thích OpenAI.
# Không đặt API key trong JavaScript hoặc commit file .env.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_private_api_key_here
# LLM_MODEL=gpt-4o-mini

# Tùy chọn: Ollama local (cần cài Ollama và model trước)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b
# LLM_API_KEY=ollama

# Tùy chọn: embedding đa ngôn ngữ (cần pip install -r requirements-semantic.txt)
# RETRIEVAL_ENCODER=sbert
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Không có API giá vàng/chứng khoán thời gian thực trong bản demo.
