# Không cần cấu hình gì để chạy chế độ trích xuất.
LLM_PROVIDER=none
RETRIEVAL_ENCODER=tfidf

# Gọi LLM thông qua API tương thích OpenAI (chỉ là ví dụ; cấu hình khi sử dụng):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=gpt-4o-mini

# Hoặc Ollama trên máy cục bộ (cần cài ollama và kéo model trước):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b
# LLM_API_KEY=ollama

# Embedding ngữ nghĩa tùy chọn (cần cài requirements-semantic.txt và tải model):
# RETRIEVAL_ENCODER=sbert
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
